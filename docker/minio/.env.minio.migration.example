# MinIO Migration Environment Changes
# Copy to .env before migration, then restore .env.backup after testing

# ============== STORAGE BACKEND SWAP ==============
# OLD: Garage
OBJECT_STORAGE_HOST=garage
OBJECT_STORAGE_PORT=3900

# NEW: MinIO (same container name pattern)
OBJECT_STORAGE_HOST=minio
OBJECT_STORAGE_PORT=9000

# ============== MILVUS MINIO ADDRESS ==============
# OLD: Garage direct
MILVUS_MINIO_ADDRESS=garage:3900

# NEW: MinIO (port 9000 is S3 API)
MILVUS_MINIO_ADDRESS=minio:9000
